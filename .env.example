# ---- Cashless Edit configuration ----
# Secret used to encrypt stored API keys and uploaded manuscripts at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Where the SQLite database, encrypted uploads and exports are stored.
DATA_DIR=./data

# Default AI provider for new accounts (each user can change this in Settings).
#   builtin        – no AI; the built-in rule engine only (proofreading, copy/line rules, stats)
#   ollama         – free, unlimited, runs on your own computer (https://ollama.com)
#   openai_compat  – any OpenAI-compatible endpoint (LM Studio, llama.cpp, Groq, Gemini, OpenRouter …)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b-instruct
# Only for openai_compat:
AI_BASE_URL=
AI_API_KEY=
